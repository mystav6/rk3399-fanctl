// apt.conf.d snippet for rk3399-fanctl
// Runs after every apt upgrade as a safety net
// (primary hook is /etc/kernel/postinst.d/rk3399-fanctl)
DPkg::Post-Invoke {
    "if [ -x /usr/sbin/rk3399-fanctl ] && [ -f /var/lib/rk3399-fanctl/state ]; then /usr/sbin/rk3399-fanctl --reapply 2>/dev/null || true; fi";
};
